# Copy to an ignored .env.vps or an absolute path outside the repository.
# No passwords, Gmail addresses, VPS IPs, or OAuth secrets belong in this example.
DOFUS_DOMAIN=economy.example.com
DOFUS_MARKET_CONTEXT=unspecified
DOFUS_DATA_PATH=/var/lib/dofus-touch-economy
DOFUS_SECRETS_PATH=/etc/dofus-touch-economy/secrets
DOFUS_PROXY_NETWORK=your_proxy_network
DOFUS_TRUSTED_PROXY_IP=172.20.0.2
GOOGLE_OAUTH_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
DOFUS_OWNER_EMAIL=owner@example.test
